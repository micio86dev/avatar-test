# BEAI Wrapper — environment example
# This file documents wrapper-level env vars (docker-compose overrides).
# Each app (api, frontend, backoffice) has its own .env.example in its own directory.
#
# Copy to .env and fill in values for local development:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose service: postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=beai
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (docker-compose service: redis)
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mailpit (docker-compose service: mailpit)
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# App service ports (used once app Dockerfiles are enabled in compose -- PR 5)
# ---------------------------------------------------------------------------
# API_PORT=8000
# FRONTEND_PORT=3000
# BACKOFFICE_PORT=3001

# Secret API key — server-side ONLY, never exposed to the browser. FILL IN.
LIVEAVATAR_API_KEY=

# "Alessandra" avatar + her Italian voice (provided defaults, no need to change).
LIVEAVATAR_AVATAR_ID=073b60a9-89a8-45aa-8902-c358f64d2852
LIVEAVATAR_VOICE_ID=c84af063-5ce2-4370-8ef8-dcd0ef903d43

# Context id — REQUIRED. Without it she connects but stays silent.
# Generate a new context ID if you don't have one already.
LIVEAVATAR_CONTEXT_ID=

# Conversation language.
LIVEAVATAR_LANGUAGE=it

TAVUS_API_KEY=
TAVUS_PERSONA_ID=p8a490c4dfd4
TAVUS_REPLICA_ID=rf4e9d9790f0
ANTHROPIC_API_KEY=